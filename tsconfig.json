{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["index.tsx", "icons/**/*.ts", "icons/**/*.tsx", "components/**/*.tsx", "tests/**/*.tsx", "scripts/**/*.tsx"]
}
